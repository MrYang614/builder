{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agents/**",
    ".codex/**",
    "node_modules/**",
    "**/target/**",
    "**/dist/**",
    "dist-ssr/**",
    "coverage/**",
    ".test-artifacts/**",
    "test-results/**",
    "playwright-report/**",
    "tests/artifacts/**",
    "apps/desktop/src-tauri/gen/**",
    "apps/desktop/src-tauri/.webdriver/**",
    "package-lock.json",
    "**/*.tsbuildinfo",
    "packages/ui/src/styles/tokens.css",
    "examples/*.source.json",
    "docs/*.json",
    "docs/PRD-v0.3.md",
    "docs/CLI-IMPLEMENTATION-PROMPT.md",
    "docs/ACCEPTANCE.md"
  ]
}
