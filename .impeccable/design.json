  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A committed primary action; medium size is 32px.",
      "html": "<button class=\"ds-button ds-primary\">Save changes</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:4px 12px;border:0;border-radius:var(--radius-md,5px);font-family:var(--font-sans);font-size:12px;font-weight:500;cursor:default;transition:background-color 150ms}.ds-button:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}.ds-button:disabled{opacity:.5;pointer-events:none}.ds-primary{background:var(--primary);color:var(--primary-foreground)}.ds-primary:hover{background:color-mix(in srgb,var(--primary) 90%,transparent)}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Neutral secondary action with an enabled control boundary.",
      "html": "<button class=\"ds-button ds-outline\">Open project</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:4px 12px;border:0;border-radius:var(--radius-md,5px);font-family:var(--font-sans);font-size:12px;font-weight:500;cursor:default;transition:background-color 150ms}.ds-button:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}.ds-button:disabled{opacity:.5;pointer-events:none}.ds-outline{background:var(--control);color:var(--foreground);border:1px solid var(--input)}.ds-outline:hover,.ds-outline:active{background:var(--secondary);color:var(--secondary-foreground)}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet toolbar action with a semantic hover surface.",
      "html": "<button class=\"ds-button ds-ghost\">Scene</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:4px 12px;border:0;border-radius:var(--radius-md,5px);font-family:var(--font-sans);font-size:12px;font-weight:500;cursor:default;transition:background-color 150ms}.ds-button:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}.ds-button:disabled{opacity:.5;pointer-events:none}.ds-ghost{background:transparent;color:var(--foreground)}.ds-ghost:hover,.ds-ghost:active{background:var(--accent);color:var(--accent-foreground)}:host-context([data-theme='dark']) .ds-ghost:hover{background:color-mix(in srgb,var(--accent) 50%,transparent)}"
    },
    {
      "name": "Numeric property field",
      "kind": "input",
      "refersTo": "numeric-field",
      "description": "Horizontal compact field with a monospace value and explicit unit.",
      "html": "<label class=\"ds-field\"><span class=\"ds-label\">Height (m)</span><span class=\"ds-input-group\"><input class=\"ds-input\" type=\"text\" inputmode=\"decimal\" value=\"2.80\" aria-label=\"Height in meters\" /></span></label>",
      "css": ".ds-field{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:12px;align-items:start;max-width:288px;font-family:var(--font-sans);color:var(--foreground)}.ds-label{padding:6px 0;font-size:11px;line-height:1.375}.ds-input-group{display:flex;height:28px;padding:0 8px;background:var(--control);border:1px solid var(--input);border-radius:var(--radius-md,5px);transition:border-color 150ms}.ds-input-group:hover:not(:focus-within):not([data-status]):not([data-disabled=true]){border-color:var(--muted-foreground)}.ds-input-group:focus-within{border-color:var(--ring);box-shadow:0 0 0 2px color-mix(in srgb,var(--ring) 50%,transparent)}.ds-input{width:100%;min-width:0;border:0;padding:0;background:transparent;color:var(--foreground);font-family:var(--font-mono);font-size:11px;font-variant-numeric:tabular-nums;outline:none}.ds-input:focus-visible{outline:none}.ds-input[aria-invalid=true]{color:var(--destructive)}"
    },
    {
      "name": "Modeling rail",
      "kind": "nav",
      "refersTo": "navigation-selected",
      "description": "Compact tool navigation; selected tool has a persistent accent state.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Modeling tools\"><button class=\"ds-tool\" aria-label=\"Select\" aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m4 4 7.07 17 2.51-7.39L21 11.07Z\" /></svg></button><button class=\"ds-tool\" aria-label=\"Wall\" aria-pressed=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M3 9h18M3 15h18M9 3v6M15 9v6M9 15v6\"/></svg></button></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;align-items:center;gap:4px;width:44px;padding:8px 4px;background:var(--background);border-right:1px solid var(--border)}.ds-tool{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;padding:0;border:0;border-radius:var(--radius-md,5px);background:transparent;color:var(--foreground)}.ds-tool svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.ds-tool:hover{background:var(--muted)}.ds-tool[aria-pressed=true],.ds-tool:active{background:var(--accent);color:var(--accent-foreground)}.ds-tool:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}"
    },
    {
      "name": "Secondary badge",
      "kind": "chip",
      "refersTo": "badge-secondary",
      "description": "A compact neutral status label from the shared component family.",
      "html": "<span class=\"ds-badge\">WebGL</span>",
      "css": ".ds-badge{display:inline-flex;max-width:100%;align-items:center;gap:4px;padding:2px 8px;border:1px solid transparent;border-radius:var(--radius-md,5px);background:var(--secondary);color:var(--secondary-foreground);font-family:var(--font-sans);font-size:11px;font-weight:500}"
    },
    {
      "name": "Shared card",
      "kind": "card",
      "refersTo": "card-shared",
      "description": "Available library container for standalone content; the editor shell stays flat.",
      "html": "<section class=\"ds-card\"><h3 class=\"ds-card-title\">Render output</h3><p class=\"ds-card-copy\">Save the current viewport as a PNG image.</p></section>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:16px;min-width:0;padding:16px;border:1px solid var(--border);border-radius:var(--radius-lg,6px);background:var(--card);color:var(--card-foreground);font-family:var(--font-sans)}.ds-card-title{margin:0;font-size:16px;font-weight:600}.ds-card-copy{margin:0;font-size:12px;line-height:1.625;color:var(--muted-foreground)}"
    },
    {
      "name": "Property disclosure",
      "kind": "custom",
      "description": "Native disclosure keeps its field content mounted while collapsing.",
      "html": "<details class=\"ds-disclosure\" open><summary><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg>Dimensions</summary><div class=\"ds-disclosure-body\">Select an object to edit its dimensions.</div></details>",
      "css": ".ds-disclosure{max-width:288px;background:var(--sidebar);color:var(--sidebar-foreground);border-bottom:1px solid var(--border);font-family:var(--font-sans)}.ds-disclosure summary{display:flex;align-items:center;gap:6px;min-height:36px;padding:8px 12px;list-style:none;cursor:pointer;color:var(--foreground);font-size:11px;font-weight:600}.ds-disclosure summary::-webkit-details-marker{display:none}.ds-disclosure summary:hover{background:var(--accent);color:var(--accent-foreground)}.ds-disclosure summary:focus-visible{outline:2px solid var(--ring);outline-offset:-2px}.ds-disclosure summary svg{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:2;color:var(--muted-foreground)}.ds-disclosure[open] summary svg{transform:rotate(90deg)}.ds-disclosure-body{padding:4px 12px 12px;font-size:11px;color:var(--muted-foreground)}"
    }
  ],
  "narrative": {
    "northStar": "The Focused Building Workspace",
    "overview": "Nova is a compact operating surface for direct building work. Neutral gray planes, a restrained blue interaction accent, and precise typography keep the editable three-dimensional scene at the center. Dark is the default; the complete light palette is authored independently.\n\nThe workspace uses continuous surfaces and small, useful controls. Structure comes from alignment, tonal steps, concise disclosure groups, and clear input boundaries. Menus and dialogs gather secondary work without turning the editor into a stack of cards. The user's explicit Nova brief replaces the former paper-and-cyan appearance; the implemented layout and semantic source are the visual authority.",
    "keyCharacteristics": [
      "The Canvas is the primary visual artifact.",
      "Dense, left-aligned controls with distinct action weights.",
      "Neutral gray surfaces with blue reserved for interaction.",
      "Local Inter for interface text; JetBrains Mono for precise values.",
      "Collapsible, adjustable side panels preserve the mounted viewport."
    ],
    "rules": [
      {
        "name": "The Single Source Rule",
        "body": "All application UI colors come from packages/ui/src/tokens/source.json through public @building/ui exports. This document is an extracted reference; update the source first and regenerate CSS with npm run tokens.",
        "section": "colors"
      },
      {
        "name": "The Boundary Rule",
        "body": "Use border for quiet structural separators and input for enabled control outlines. Keep enabled input boundaries at least 3:1 against their adjacent control surface; a panel divider is not a substitute for an input outline.",
        "section": "colors"
      },
      {
        "name": "The Numeric Role Rule",
        "body": "Use JetBrains Mono with tabular numerals for coordinates, dimensions, angles, sample counts, and technical readouts. Keep labels, menus, buttons, help, and prose in Inter.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "The viewport and docked panels have no inset card or decorative shadow. Reserve overlay and shadow tokens for floating menus, tooltips, dialogs, and their backdrops.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic tokens in both themes and preserve equal theme keys.",
      "Do keep numeric values and units aligned, with clear labels and validation messages.",
      "Do retain hover, selected, focus, disabled, loading, error, and success feedback where the control supports those states.",
      "Do keep pane sizing and collapse state local to UI presentation; retain one mounted Canvas.",
      "Do route property and pointer edits through the same EditorCore commands; one committed drag is one history item.",
      "Do preserve project, session, runtime, and local-preference ownership and export an independent revision snapshot."
    ],
    "donts": [
      "Don't restore the discarded paper-and-cyan identity or make light the fallback default.",
      "Don't stack SaaS-style cards, add decorative gradients, over-round the workspace, or use shadows to divide docked regions.",
      "Don't make every control primary or use blue as a large decorative surface.",
      "Don't apply JetBrains Mono to ordinary interface prose or depend on a network font request.",
      "Don't replace enabled control outlines with quiet divider tokens.",
      "Don't remount the renderer for pane, theme, language, or dialog changes, duplicate formal document state, or write transient previews into history.",
      "Don't introduce iframe, R3F, Next.js, a backend service, or a plugin layer into the production editor."
    ]
  }
}
