{
  "name": "building-editor-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "storybook": "npm run dev --workspace @building/storybook --",
    "build:storybook": "npm run check && npm run typecheck --workspace @building/storybook && npm run build --workspace @building/storybook",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "build": "npm run check && tsc --noEmit && vite build --config apps/desktop/vite.config.ts",
    "check": "npm run format:check && npm run lint && npm run check:architecture",
    "check:architecture": "node scripts/check.mjs",
    "format": "oxfmt --write -c .oxfmtrc.json .",
    "format:check": "oxfmt --check -c .oxfmtrc.json .",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint -c .oxlintrc.json --deny-warnings --report-unused-disable-directives --fix .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p packages/editor-core/tsconfig.json && tsc --noEmit -p packages/building-geometry/tsconfig.json && npm run typecheck --workspace @building/storybook",
    "tokens": "node scripts/generate-tokens.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:webgpu": "playwright test --config playwright.webgpu.config.ts",
    "test:regression": "playwright test --config playwright.regression.config.ts",
    "bench": "tsx scripts/benchmark.ts",
    "bench:bvh": "tsx scripts/benchmark-bvh.ts",
    "preview": "vite preview --config apps/desktop/vite.config.ts",
    "tauri": "cd apps/desktop && tauri",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "verify": "npm run check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "three-gpu-pathtracer": "0.0.26",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "25.5.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "shadcn": "4.21.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "5.0.3"
  }
}
